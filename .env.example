# ==============================================================================
# AgroSense Production Environment Configuration
# ==============================================================================
# NOTE: Server-side secrets must NEVER be prefixed with VITE_ to prevent
# accidental leakage to client browser JavaScript bundles.
# ==============================================================================

# Google Gemini Vision API Key (Required for server-side /api/analyze-plant)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-3.5-flash or gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Active AI Inference Provider (gemini | onnx)
# Production default: gemini
AI_PROVIDER=gemini

# Fallback Provider Configuration (Default: none)
# NOTE: Automatic fallback is disabled by default to maintain provenance truth.
AI_FALLBACK_PROVIDER=none
